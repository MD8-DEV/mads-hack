# Venture Validator settings. Copy to .env and fill in what you use.
# Placeholders only: never commit real keys. No paid service is required.

# --- Model providers (any one is enough; all are free) ---------------------------------
# Hack Club AI proxy (free models end in ":free"): https://ai.hackclub.com
HACKCLUB_API_KEY=
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# NVIDIA build free tier: https://build.nvidia.com
NVIDIA_API_KEY=
# Local open-weight model via Ollama (https://ollama.com), e.g. after `ollama pull qwen3:8b`.
# Outside Docker: http://localhost:11434   With `docker compose --profile local up`: http://ollama:11434
OLLAMA_BASE_URL=

# Optional base-URL overrides (defaults shown)
# HACKCLUB_BASE_URL=https://ai.hackclub.com/proxy/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Model chains: ordered fallbacks, "provider:model" separated by commas -------------
# Leave empty to use the defaults:
# MODEL_CHAIN_MAIN=hackclub:nvidia/nemotron-3-ultra-550b-a55b:free,groq:openai/gpt-oss-120b,nvidia:nvidia/nemotron-3-ultra-550b-a55b,hackclub:nvidia/nemotron-3.5-super-vl:free,ollama:qwen3:8b
# MODEL_CHAIN_FAST=hackclub:google/gemma-4-26b-a4b-it:free,groq:openai/gpt-oss-120b,hackclub:nvidia/nemotron-3.5-super-vl:free,nvidia:nvidia/nemotron-3-ultra-550b-a55b,ollama:qwen3:8b
MODEL_CHAIN_MAIN=
MODEL_CHAIN_FAST=

# Seconds to wait for one model reply before trying the next route
LLM_TIMEOUT_SECONDS=90
# Daily spend cap in USD for paid Hack Club routes. 0 = paid routes are never used.
DAILY_BUDGET_USD=0

# --- Desk research over free public sources --------------------------------------------
# 1 = on, 0 = off
RESEARCH_ENABLED=1
RESEARCH_TIMEOUT_SECONDS=20

# --- Storage ------------------------------------------------------------------------------
# Where runs are stored. Empty = ./data (Docker sets /app/data).
DATA_DIR=

# --- Web server when started with `python app.py` (Docker always uses 0.0.0.0:8000) ------
# HOST=127.0.0.1
# PORT=8000
